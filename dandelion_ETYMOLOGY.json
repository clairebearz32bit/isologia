b\u0435\u0447\u043a\u0430|f}}, {{t|mk|\u043c\u043b\u0435\u0447\u0430\u0458\u043a\u0430|f}}\n* Malay: {{t|ms|dandelion}}, {{t|ms|paliman}}, {{t|ms|\u06a4\u0644\u064a\u0645\u0646}}\n* Malayalam: {{t|ml|\u0d05\u0d2a\u0d4d\u0d2a\u0d42\u0d2a\u0d4d\u0d2a\u0d7b\u0d24\u0d3e\u0d1f\u0d3f|n}}\n* M\u0101ori: {{t|mi|tohetaka}}, {{t|mi|tohetake}}, {{t|mi|tawao}}\n* Mongolian:\n*: Cyrillic: {{t|mn|\u0431\u0430\u0433\u0432\u0430\u0430\u0445\u0430\u0439 \u0446\u044d\u0446\u044d\u0433}}\n*: Mongolian script: {{t|mn|\u182a\u1820\u182d\u182a\u1820\u182c\u1820\u1836 \u1834\u1821\u1834\u1821\u182d}}\n* Nogai: {{t|nog|\u043c\u0430\u044c\u043c\u0435\u0442\u0435\u043a\u0435\u0439}}\n* Norman: {{t|nrf|pissenl\u00eet|m}}, {{t|nrf|dent-de-lion|f}}\n* Norwegian:\n*: Bokm\u00e5l: {{t+|nb|l\u00f8vetann|m|f}}\n*: Nynorsk: {{t|nn|l\u00f8vetann|f}}\n* Nuosu: {{t|ii|\ua0ee\ua0c0\ua2d9\ua20c}}\n* Occitan: {{t|oc|dent de leon|f}}, {{t+|oc|pissalach|m}}, {{t|oc|grav\u00e8l|m}}\n* Old English: {{t|ang|\u01e3\u0121wyrt|f}}\n* Pannonian Rusyn: {{t|rsk|\u043b\u0430\u043c\u043f\u0430\u0449\u0438\u043a|m}}, {{t|rsk|\u0433\u0443\u0448\u0430\u0442\u043a\u043e\u0432\u043e \u043a\u0432\u0435\u0446\u0435|n}}, {{t|rsk|\u0433\u0443\u0448\u0430\u0442\u043a\u043e\u0432\u0430 \u0442\u0440\u0430\u0432\u0430|f}}\n* Persian: {{t+|fa|\u0642\u0627\u0635\u062f\u06a9|tr=q\u00e2sedak}}\n* Plautdietsch: {{t|pdt|Schlangenbloom|f}}\n* Polish: {{t+|pl|mniszek|m}}, {{t+|pl|podbia\u0142|m}}, {{t+|pl|dmuchawiec|m}}, {{t+|pl|mlecz|m}}\n* Portuguese: {{t+|pt|dente-de-le\u00e3o|m}}\n* Romanian: {{t+|ro|p\u0103p\u0103die|f}}\n* Russian: {{t+|ru|\u043e\u0434\u0443\u0432\u0430\u0301\u043d\u0447\u0438\u043a|m}}\n* Scottish Gaelic: {{t|gd|be\u00e0rnan-Br\u00ecde|m}}, {{t|gd|bior nam Br\u00ecde|m}}, {{t|gd|caisearbhan nam muc|m}}, {{t|gd|fiacaill-le\u00f2mhainn|f}}\n* Serbo-Croatian:\n*: Cyrillic: {{t|sh|\u043c\u0430\u0441\u043b\u0430\u0301\u0447\u0430\u043a|m}}\n*: Latin: {{t+|sh|masl\u00e1\u010dak|m}}\n* Slovak: {{t+|sk|p\u00fapava|f}}\n* Slovene: {{t+|sl|regrat|m}}\n* Southern Altai: {{t|alt|\u0430\u043a \u0431\u0430\u0448}}, {{t|alt|\u0441\u04f1\u0442-\u0447\u0435\u0447\u0435\u043a}}\n* Spanish: {{t+|es|diente de le\u00f3n|m}}, {{t|es|[[diente]] [[leon\u00e9s]]|m}}\n* Swedish: {{t+|sv|maskros|c}}\n* Tagalog: {{t+|tl|ngiping-leon}}, {{t+|tl|amargon}}\n* Tajik: {{t|tg|\u043a\u043e\u049b\u0443}}\n* Tamil: {{t|ta|\u0b9a\u0bc0\u0bae\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bc1\u0bb3\u0bcd\u0bb3\u0b99\u0bcd\u0b95\u0bbf}}\n* Tashelhit: {{t|shi|\u2d61\u2d30\u2d61\u2d4a\u2d39\u2d4e|m}}, {{t|shi|\u2d30\u2d61\u2d4a\u2d39\u2d49\u2d4e|m}}\n* Tatar: {{t+|tt|\u0442\u0443\u0437\u0433\u0430\u043d\u0430\u043a}}\n* Telugu: {{t-needed|te}}\n* Thai: {{t|th|\u0e41\u0e14\u0e19\u0e14\u0e35\u0e49\u0e44\u0e25\u0e2d\u0e2d\u0e19|tr=daend\u00eaelaion}}\n* Turkish: {{t+|tr|karahindiba}}, {{t|tr|radika}}, {{t|tr|aslan di\u015fi}}\n*: Ottoman Turkish: {{t|ota|\u0647\u0646\u062f\u0628\u0627|tr=hindiba}}, {{t|ota|\u0643\u0648\u0646\u0647\u200c\u06cc\u0643|tr=g\u00fcneyik}}\n* Turkmen: {{t|tk|tozga}}\n* Ukrainian: {{t|uk|\u043a\u0443\u043b\u044c\u0431\u0430\u0301\u0431\u0430|f}}\n* Uyghur: {{t|ug|\u0645\u0627\u0645\u0643\u0627\u067e}}\n* Uzbek: {{t+|uz|qoqi}}, {{t+|uz|qoqigul}}, {{t+|uz|gulqoqi}}, {{t+|uz|momaqaymoq}}\n* Vietnamese: {{t|vi|b\u1ed3 c\u00f4ng anh}}\n* Volap\u00fck: {{qualifier|plant}} {{t+|vo|tarak}}, {{qualifier|flower}} {{t+|vo|tarakaflor}}\n* Walloon: {{t+|wa|s\u00e5vaedje c\u00e9coreye|f}}, {{t|wa|dint-d'-liyon|m}}, {{t|wa|pixhel\u00e9t|m}}, {{t+|wa|sal\u00e5de des tchamps|f}}\n* Welsh: {{t+|cy|dant y llew|m}}\n* Yiddish: {{t|yi|\u05d1\u05dc\u05e2\u05d6\u05e2\u05e8\u05dc|n}}, {{t|yi|\u05dc\u05d5\u05e4\u05bf\u05d8\u05dc|n}}\n{{trans-bottom}}\n\n{{trans-top|color of a dandelion flower, dandelion color, dandelion yellow}}\n* Finnish: {{t|fi|voikukankeltainen}}\n* German: {{t|de|L\u00f6wenzahnfarbe|f}}, {{t|de|L\u00f6wenzahngelb|n}}\n* Polish: {{t|pl|[[kolor]] [[mniszek|mniszka]]|m}}\n* Spanish: {{t|es|[[color]] [[leonado]]|m}}, {{t|es|[[color]] [[aleonado]]|m}}\n* Volap\u00fck: {{t|vo|tarakaflorak\u00f6l}}, {{t|vo|tarakaflorayelov}}\n{{trans-bottom}}\n\n===Adjective===\n{{en-adj|-}}\n\n# Of a [[yellow]] colour, like that of the flower.\n\n====Translations====\n{{trans-top|of a yellow colour}}\n* Danish: {{t+|da|m\u00e6lkeb\u00f8tte}}, {{t|da|l\u00f8vetand}}\n* Finnish: {{t|fi|voikukankeltainen}}\n* French: {{t+|fr|pissenlit|m}}\n* German: {{t|de|l\u00f6wenzahnfarbig}}, {{t|de|l\u00f6wenzahngelb|n}}\n* Hungarian: {{t|hu|pitypangs\u00e1rga}}\n* Norwegian: {{t+|no|l\u00f8vetann}}\n* Polish: {{t+|pl|\u017c\u00f3\u0142ty}}\n* Slovene: {{t+|sl|rumen|m}}, {{t|sl|rumena|f}}\n* Spanish: {{t+|es|leonado}}, {{t+|es|aleonado}}\n* Volap\u00fck: {{t|vo|tarakaflorak\u00f6lik}}, {{t|vo|tarakaflorayelovik}}\n{{trans-bottom}}\n\n===See also===\n* {{l|en|clock}}\n* {{l|en|goatsbeard}}\n* {{l|en|hawk's beard}}\n* {{l|en|kok-saghyz}}\n* {{l|en|oxtongue}}\n* {{l|en|pissabed}}\n* {{taxfmt|Taraxacum|genus}}\n* [[Appendix:Colors]]\n\n===Anagrams===\n* {{anagrams|en|a=addeilnno|daldinone}}\n\n{{C|en|Cichorieae tribe plants|Flowers|Yellows}}"